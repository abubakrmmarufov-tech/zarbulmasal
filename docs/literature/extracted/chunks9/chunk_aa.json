[
  {
    "poet": "Носири Бухороӣ",
    "poems": [
      "Саломи ман бирасон, эй сабо, Бухороро"
    ]
  },
  {
    "poet": "Авҳадии Мароғӣ",
    "poems": [
      "Зулмати зулм тира дорад роҳ",
      "Ҷоми Ҷам"
    ]
  },
  {
    "poet": "Хоҷуи Кирмонӣ",
    "poems": [
      "Хуррам он рӯз, ки аз хиттаи Кирмон биравам"
    ]
  },
  {
    "poet": "Сайфи Исфарангӣ",
    "poems": [
      "Ранги шафақ аз акси рухи зарди ман аст"
    ]
  },
  {
    "poet": "Сироҷиддини Қумрӣ",
    "poems": [
      "Эй абри баҳор, хор парвардаи туст"
    ]
  },
  {
    "poet": "Ҷалолиддини Балхӣ",
    "poems": [
      "Маснавии маънавӣ"
    ]
  },
  {
    "poet": "Низомии Ганҷавӣ",
    "poems": [
      "Хамса"
    ]
  },
  {
    "poet": "Амир Хусрави Деҳлавӣ",
    "poems": [
      "Хамса",
      "Матлаъ-ул-анвор",
      "Маҷнун ва Лайлӣ",
      "Оинаи сикандарӣ",
      "Ҳашт биҳишт"
    ]
  },
  {
    "poet": "Соҳиби Шерозӣ",
    "poems": [
      "Дафтари дилкушо"
    ]
  },
  {
    "poet": "Салмони Соваҷӣ",
    "poems": [
      "Фироқнома",
      "Ҷамшеду Хуршед"
    ]
  },
  {
    "poet": "Ҳайдари Шерозӣ",
    "poems": [
      "Суҳбатнома"
    ]
  },
  {
    "poet": "Заҳири Форёбӣ",
    "poems": [
      "Нуҳ курсии фалак ниҳад андеша зери пой"
    ]
  },
  {
    "poet": "Саъдии Шерозӣ",
    "poems": [
      "Алами давлати Наврӯз",
      "Бозгашт",
      "Бигзор, то бигирям",
      "Қимати гул",
      "Эй сорбон",
      "Моро биҳишт суҳбати ёрони ҳамдам аст",
      "Бӯстон",
      "Гулистон"
    ]
  }
]
