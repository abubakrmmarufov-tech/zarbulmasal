  {
    "poet": "Пайрав Сулаймонӣ",
    "poems": [
      "Бародари ҷонӣ",
      "Тахти хунин",
      "Бок нест",
      "То кай",
      "Шаби ҳиҷрон бо хаёли ҷонон",
      "Чӣ шуд, ки?..",
      "Фироқнома",
      "Интихоби маъшуқ",
      "Шукуфаи ирфон ё худ озодии занони Шарқ",
      "Ба шарафи қиёми занони Шарқ",
      "Асира ё худ исён",
      "Ду ҳуҷум",
      "Якуми Май ва МОПР",
      "Ба тахтнишин",
      "Як қурбонии кӯчаи буржуазии Аврупо",
      "Ҷумҳурияти Тоҷикистон ва матбуоти ранҷбари тоҷик",
      "Манораи марг"
    ]
  },
  {
    "poet": "Ҳабиб Юсуфӣ",
    "poems": [
      "Аз ҳавою обу замин",
      "Таронаи Ватан",
      "Оби ҳаёт",
      "Лаҳзаи хурсандии ман",
      "Ишқи Ватан",
      "Ба Ватан",
      "Ватани дил",
      "Ба ҳар куҷот равам, дил диёри ман гӯяд",
      "Ман Ватанро беш аз ҳарвақта дорам дӯсттар",
      "Таърих дидааст",
      "Ба духтари меҳнат",
      "Ҳусни ту",
      "Такя бар корат кунӣ",
      "Духтари ҳавопаймо",
      "Ту духтари ватанӣ"
    ]
  },
