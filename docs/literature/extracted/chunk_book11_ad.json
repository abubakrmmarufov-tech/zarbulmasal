[
  {
    "poet": "Абулқосим Лоҳутӣ",
    "poems": [
      "Аё сайёд",
      "Шамъу парвона",
      "Дар Калкутта",
      "Чамани сӯхта",
      "Дар фабрики сармоядорон",
      "Ваҳдат ва ташкилот",
      "Ман фарзанди як деҳқоне будам",
      "Эй духтари номдори Эрон",
      "Писари ҳафтуми сотсиализм",
      "Кремл",
      "Мо зафар хоҳем кард",
      "Сафари Фарангистон",
      "Тоҷу байрақ",
      "Ду нишон",
      "Одами оҳанпо",
      "Шамшери фотеҳ",
      "Мардистон",
      "Ғалабаи Таня",
      "Се қатра",
      "Парии Бахт",
      "Кӯҳ ва ойина",
      "Мӯр ва офтоб",
      "Паҳлавон Оштӣ",
      "Саройи тамаддун",
      "Духтари инқилоб",
      "Хар ва трактор",
      "Тоҷикистон шуд мунаввар",
      "Хабар",
      "Тоҷикистон",
      "Ба Тоҷикистон",
      "Мо ранҷбарзодагонем",
      "Озодии занҳо",
      "Таронаи партизанӣ",
      "Духтари Тоҷикистон",
      "Ошиқам, ошиқ ба рӯят",
      "Боз ҳам ёр ба рақс омадааст",
      "Охир, эй маҳ, ҳалок шуд дили ман",
      "Парвона медонад",
      "Даррандагонро бизанем",
      "Суруди ҷангии ҷавонон",
      "Марши ваҳдат",
      "Хасми башар",
      "Тарона",
      "Гитлер ва фашизми Германия",
      "Алла",
      "Бути нозанинам",
      "Ёри масчоҳӣ",
      "Ханҷари заҳмат",
      "Эй дил, эй дил",
      "Имрӯз ба пеши ёр рафтам"
    ]
  },
