[
  {
    "poet": "Лоиқ Шералӣ",
    "poems": [
      "Ҷомаи гадоӣ",
      "Фарёди бефарёдрас",
      "Соқиномаи имрӯзин",
      "Зангӯлаи бедорӣ",
      "Барои соҳибназарон",
      "Алорағми маҳалгароён",
      "Зарафшон, модари зорам",
      "Хонаи шоир",
      "Ману ту",
      "Гӯри Дониш дар куҷост?",
      "Чашмони Олимпур",
      "Илтиҷо аз камонмардон",
      "Падарам, во падарам",
      "Марсияи Ҷамшед",
      "Забонгумкарда",
      "Хоки Ватан",
      "Деҳи кӯчида",
      "Ганҷи кӯҳистон",
      "Модар",
      "Қасидаи модар",
      "Қарз",
      "Волотар аз ҳама"
    ]
  },
  {
    "poet": "Бозор Собир",
    "poems": [
      "Пайванд",
      "Оташбарг",
      "Гули хор",
      "Мижгони шаб",
      "Офтобниҳол",
      "Бо чамидан, бо чашидан...",
      "Чашми сафедор",
      "Аз Ватан вақте ки мерафтам",
      "Аз Гули хор то Симхор",
      "Хуни қалам",
      "Лолаи сиёҳ",
      "Боғи момаи ангур",
      "Мо кӯдакон будем",
      "Кӯдакиям ҳанӯз гирён аст",
      "Чашм бар ҳошияи сабзи уфуқ",
      "Кӯдакӣ ку?",
      "Бачаҳои деҳотӣ",
      "Тоҷикистон",
      "Дар оғӯши кӯҳистон",
      "Забони модарӣ",
      "Теғи Сино",
      "Ман худамро кушта-кушта",
      "Асп"
    ]
  }
]
