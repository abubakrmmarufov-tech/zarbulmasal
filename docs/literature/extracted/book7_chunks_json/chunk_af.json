[
  {
    "poet": "Ҳабиб Юсуфӣ",
    "poems": [
      "БА ВАТАН",
      "БА ҲАР КУҶО-Т РАВАМ, ДИЛ ДИЁРИ МАН ГӮЯД",
      "МАН ВАТАНРО БЕШ АЗ ҲАРВАҚТА ДОРАМ ДӮСТТАР"
    ]
  },
  {
    "poet": "Боқӣ Раҳимзода",
    "poems": [
      "МУАЛЛИМ",
      "ХАЛҚИ БУЗУРГВОРАМ"
    ]
  },
  {
    "poet": "Муҳиддин Аминзода",
    "poems": [
      "ТАЪЛИМИ УМУМИИ МАҶБУРӢ",
      "ХӮША ВА ДЕҲҚОН",
      "БЕСАВОДӢ БАЛОИ ҶОН БОШАД",
      "РАПОРТИ БАҲОРӢ",
      "БАҲОРИ НАВ",
      "МО ҶАНГ НАМЕХОҲЕМ",
      "ИМЗО МЕКУНЕМ",
      "БА ФАРЗАНДАМ"
    ]
  }
]
