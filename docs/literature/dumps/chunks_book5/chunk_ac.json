[
  {
    "poet": "НИЗОМУЛМУЛК",
    "poems": [
      "ЧАНД ҲИКОЯТ АЗ «СИЁСАТНОМА»",
      "Исмоили Сомонӣ ва Амри Лайс",
      "ЧАРО ОЛИ СОСОН ЗАВОЛ ЁФТ ?",
      "ҶАВОБИ УМАРИ ХАТТОБ БА ЯЗДИГУРД",
      "БОЗАРГОН ВА СУЛТОН МАҲМУД",
      "УМАР ВА ПИРАЗАН",
      "ТАДБИРИ СУЛТОН",
      "ХАРИ ҶАБРДИДА"
    ]
  },
  {
    "poet": "АҲМАДИ ҶОМӢ",
    "poems": [
      "ҲЕЧ НЕСТ",
      "МУМТОЗ ШУД"
    ]
  },
  {
    "poet": "АТТОРИ НИШОПУРӢ",
    "poems": [
      "ПАНДНОМАИ АТТОР ДАР БАЁНИ ОН КИ СЕ ЧИЗ АЛОМАТИ САОДАТМАНДӢ АСТ",
      "ДАР БАЁНИ ОН, КИ СЕ ЧИЗ АЛОМАТИ РАСТАГОРИСТ",
      "ДАР БАЁНИ ОН КИ ЧАҲОР ЧИЗ АСТ, КИ БАЪД АЗ РАФТАН ОВАРДАНИ ОН МУҲОЛ АСТ",
      "ДАР БАЁНИ ОДОБИ СУХАН КАРДАН БО МАРДУМОН",
      "ДАР БАЁНИ ЭҲТИЁТ АЗ ДУШМАНОН",
      "ДАР БАЁНИ ОН КИ ХОРӢ ОВАРАД",
      "ДАР БОРАИ ФАЗИЛАТИ МЕҲМОН",
      "ДАР БАЁНИ ФАЗИЛАТИ МАҚБУЛОН",
      "ДАР БАЁНИ ҒАМХОРИИ МАРДУМ",
      "АНДАРЗҲО"
    ]
  },
  {
    "poet": "САЪДИИ ШЕРОЗӢ",
    "poems": [
      "ҲИКОЯТҲО АЗ «ГУЛИСТОН»",
      "ХИРАДИ НӮШЕРВОНИ ОДИЛ",
      "ДУОИ ДАРВЕШ",
      "ДУ ШОҲЗОДА",
      "ҶАБРИ УСТОД БЕҲ АЗ МЕҲРИ ПАДАР!",
      "ДУ ДАРВЕШ",
      "ЧАШМИ ТАНГИ ДУНЁДОР",
      "ДУ БАРОДАР",
      "ДАРВЕШИ ҲОҶАТМАНД ВА ТУНДРӮЙИ ДАВЛАТМАНД",
      "ПАНДҲО",
      "БАЙТ",
      "ҚИТЪА",
      "САЪДӢ ВА ПОДШОҲИ НОИНСОФ",
      "ФАРД",
      "Банӣ Одам",
      "ШУҶОАТИ МАЛИКЗОДА",
      "БУЛБУЛ ВА МӮР"
    ]
  }
]
