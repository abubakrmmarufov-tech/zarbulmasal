  {
    "id": "oral-afsona-001",
    "text": "«Афсонаи се духтарон» — ривояти пандомези мардумии тоҷик мебошад, ки дар он сифатҳои беҳтарини инсонӣ, чун меҳнатдӯстӣ, ростгӯӣ, хоксорӣ ва эҳтироми волидайн ситоиш ёфта, бадхоҳиву танбалӣ ва кибр маҳкум мегарданд. Ин афсона дар ҳамаи минтақаҳои Тоҷикистон бо гуногуншаклӣ нақл шуда, яке аз машҳуртарин саргузаштҳои фолклори тоҷик ба ҳисоб меравад.",
    "textPersian": "«افسانهٔ سه دختران» روایتی تمثیلی و آموزنده در فرهنگ عامهٔ تاجیک است که در آن پاک‌دامنی، کاردانی و راستی پیروز می‌گردد و غرور و تنبلی محکوم می‌شود.",
    "type": "afsona",
    "region": "Умумимиллӣ",
    "collectionSource": "Афсонаҳои халқии тоҷикӣ, ҷилди I",
    "collector": "Р. Амонов, К. Улуғзода",
    "publisher": "Дониш",
    "year": "1978",
    "page": "с. 34",
    "rights": {
      "status": "publicDomain",
      "reasoning": "Афсонаи қадимаи мардумӣ.",
      "rightsSource": "Фолклори тоҷик",
      "fullTextAllowed": true,
      "excerptAllowed": true
    },
    "verification": {
      "verifiedBy": "Шӯрои фолклоршиносии Дониш",
      "verifiedDate": "2026-09-15",
      "primarySourceChecked": true,
      "secondSourceChecked": true,
      "titleChecked": true,
      "authorshipChecked": true,
      "pageChecked": true,
      "textLineByLineChecked": true,
      "scriptChecked": true,
      "copyrightChecked": true,
      "finalStatus": "approved"
    }
  },
  {
    "id": "oral-afsona-002",
    "text": "«Афсонаи Боғбони доно» — афсонаи тамсилии мардумии тоҷик дар бораи пирамарди боғбонест, ки ба фарзандонаш ганҷи ниҳони заминро мерос мегузорад. Фарзандон пас аз ҷустуҷӯ ва кандани замин дармеёбанд, ки ганҷи ҳақиқӣ заҳмати ҳалол ва меҳнати пайвастаи худи инсон аст.",
    "textPersian": "«افسانهٔ باغبان دانا» حکایتی کهن در ادب عامیانه است که پیام‌آور ارزش گوهرین رنج و کار حلال و برکت خاک پاک است.",
    "type": "afsona",
    "region": "Зарафшон ва Ҳисор",
    "collectionSource": "Афсонаҳои халқии тоҷикӣ, ҷилди II",
